#!/usr/bin/env python3
"""OmaFolder state engine.

The single source of truth for which Omarchy bar widgets are folded into the
OmaFolder drawer. Folding a widget removes its entry from the bar layout in
``~/.config/omarchy/shell.json``; ejecting puts it back where it came from.
Nothing else in the shell config is touched.

Every command prints exactly one JSON object on stdout and exits non-zero with
``{"ok": false, "error": "..."}`` on failure, so the QML side can read the
result without parsing prose.

Commands:
  init                          create state.json when missing
  summary                       state items merged with discovered plugin metadata
  bar-modules                   widgets currently on the bar, grouped by section
  fold <id>                     move a bar widget into the drawer
  eject <id>                    move a drawer item back onto the bar
  toggle <id>                   flip an item's active state
  reorder <id> <index>          move an item to a new position in the drawer
  active <id> <true|false>      set an item's active state explicitly
"""

from __future__ import annotations

import json
import os
import shutil
import subprocess
import sys
import tempfile
import time

PLUGIN_ID = "io.github.shayanshahravi.omafolder"
SECTIONS = ("left", "center", "right")

HOME = os.path.expanduser("~")
CONFIG_DIR = os.path.join(HOME, ".config", "omafolder")
STATE_PATH = os.environ.get("OMAFOLDER_STATE") or os.path.join(CONFIG_DIR, "state.json")
SHELL_PATH = os.environ.get("OMAFOLDER_SHELL") or os.path.join(
    HOME, ".config", "omarchy", "shell.json"
)
BACKUP_DIR = os.path.join(HOME, ".local", "state", "omafolder", "backups")
# Test runs point the engine at throwaway files; never poke the live shell then.
LIVE = not (os.environ.get("OMAFOLDER_STATE") or os.environ.get("OMAFOLDER_SHELL"))


def out(payload):
    payload.setdefault("ok", True)
    sys.stdout.write(json.dumps(payload) + "\n")
    return 0


def die(message):
    sys.stdout.write(json.dumps({"ok": False, "error": message}) + "\n")
    return 1


def atomic_write(path, data):
    directory = os.path.dirname(path) or "."
    os.makedirs(directory, exist_ok=True)
    handle, temp = tempfile.mkstemp(dir=directory, prefix=".omafolder-", suffix=".json")
    try:
        with os.fdopen(handle, "w", encoding="utf-8") as stream:
            json.dump(data, stream, indent=2)
            stream.write("\n")
        os.replace(temp, path)
    except BaseException:
        if os.path.exists(temp):
            os.unlink(temp)
        raise


def backup(path):
    if not os.path.exists(path):
        return ""
    os.makedirs(BACKUP_DIR, exist_ok=True)
    stamp = time.strftime("%Y%m%d-%H%M%S")
    destination = os.path.join(BACKUP_DIR, "%s-%s.bak" % (os.path.basename(path), stamp))
    shutil.copy2(path, destination)
    return destination


def read_json(path, fallback=None):
    try:
        with open(path, "r", encoding="utf-8") as stream:
            return json.load(stream)
    except FileNotFoundError:
        return fallback
    except (OSError, ValueError) as error:
        raise SystemExit(die("cannot read %s: %s" % (path, error)))


def load_state():
    state = read_json(STATE_PATH, None)
    if not isinstance(state, dict):
        state = {"version": 1, "pluginId": PLUGIN_ID, "items": []}
    if state.get("version") != 1:
        state = {"version": 1, "pluginId": PLUGIN_ID, "items": []}
    items = state.get("items")
    if not isinstance(items, list):
        items = []
    cleaned = []
    for entry in items:
        if not isinstance(entry, dict):
            continue
        plugin_id = str(entry.get("id") or "").strip()
        if plugin_id == "" or plugin_id == PLUGIN_ID:
            continue
        cleaned.append(
            {
                "id": plugin_id,
                "active": bool(entry.get("active", True)),
                "section": entry.get("section") if entry.get("section") in SECTIONS else "right",
                "index": int(entry.get("index") or 0),
            }
        )
    state["items"] = cleaned
    state.setdefault("version", 1)
    state["pluginId"] = PLUGIN_ID
    return state


def save_state(state):
    atomic_write(STATE_PATH, state)


def load_shell(required=True):
    shell = read_json(SHELL_PATH, None)
    if not isinstance(shell, dict):
        if required:
            raise SystemExit(die("no bar layout at %s" % SHELL_PATH))
        return None
    return shell


def layout_of(shell):
    bar = shell.get("bar")
    if not isinstance(bar, dict):
        bar = {}
        shell["bar"] = bar
    layout = bar.get("layout")
    if not isinstance(layout, dict):
        layout = {}
        bar["layout"] = layout
    for section in SECTIONS:
        if not isinstance(layout.get(section), list):
            layout[section] = []
    return layout


def entry_id(entry):
    if isinstance(entry, str):
        return entry
    if isinstance(entry, dict):
        return str(entry.get("id") or "")
    return ""


def find_entry(layout, plugin_id):
    for section in SECTIONS:
        for index, entry in enumerate(layout[section]):
            if entry_id(entry) == plugin_id:
                return section, index
    return None, None


def remove_entry(layout, plugin_id):
    removed = None
    for section in SECTIONS:
        entries = layout[section]
        kept = []
        for index, entry in enumerate(entries):
            if entry_id(entry) == plugin_id and removed is None:
                removed = {"section": section, "index": index, "entry": entry}
                continue
            kept.append(entry)
        layout[section] = kept
    return removed


def insert_entry(layout, plugin_id, section, index):
    if section not in SECTIONS:
        section = "right"
    entries = layout[section]
    position = max(0, min(int(index or 0), len(entries)))
    entries.insert(position, {"id": plugin_id})
    return section, position


def reload_shell():
    if not LIVE:
        return False
    try:
        subprocess.run(
            ["omarchy-shell", "-q", "shell", "reloadConfig"],
            timeout=5,
            stdout=subprocess.DEVNULL,
            stderr=subprocess.DEVNULL,
            check=False,
        )
    except (OSError, subprocess.SubprocessError):
        return False
    return True


def plugin_index():
    """Map plugin id -> {name, kinds} from the shell's discovery list."""
    try:
        result = subprocess.run(
            ["omarchy", "plugin", "list", "--json"],
            capture_output=True,
            text=True,
            timeout=8,
            check=False,
        )
        rows = json.loads(result.stdout or "[]")
    except (OSError, subprocess.SubprocessError, ValueError):
        return {}
    index = {}
    for row in rows if isinstance(rows, list) else []:
        if not isinstance(row, dict):
            continue
        plugin_id = str(row.get("id") or "")
        if plugin_id == "":
            continue
        kinds = row.get("kinds")
        index[plugin_id] = {
            "name": str(row.get("name") or plugin_id),
            "kinds": kinds if isinstance(kinds, list) else [],
        }
    return index


def describe(kinds):
    labels = []
    for kind in kinds or []:
        label = {
            "bar-widget": "Bar widget",
            "panel": "Panel",
            "overlay": "Overlay",
            "menu": "Menu",
            "service": "Service",
            "bar": "Bar",
        }.get(str(kind), str(kind))
        if label not in labels:
            labels.append(label)
    return " · ".join(labels)


def enrich(state):
    index = plugin_index()
    items = []
    for position, entry in enumerate(state["items"]):
        meta = index.get(entry["id"], {})
        kinds = meta.get("kinds", [])
        items.append(
            {
                "id": entry["id"],
                "active": bool(entry.get("active", True)),
                "section": entry["section"],
                "index": entry["index"],
                "position": position,
                "name": meta.get("name") or entry["id"],
                "kinds": kinds,
                "kindLabel": describe(kinds) or "Bar widget",
                "summonable": any(
                    kind in ("bar-widget", "panel", "menu", "overlay", "bar") for kind in kinds
                ),
            }
        )
    return items


# --------------------------------------------------------------------- commands


def command_init(_args):
    state = load_state()
    save_state(state)
    return out({"statePath": STATE_PATH, "items": len(state["items"])})


def command_summary(_args):
    state = load_state()
    items = enrich(state)
    return out(
        {
            "items": items,
            "count": len(items),
            "activeCount": sum(1 for item in items if item["active"]),
            "statePath": STATE_PATH,
            "shellPath": SHELL_PATH,
        }
    )


def command_bar_modules(_args):
    shell = load_shell()
    layout = layout_of(shell)
    state = load_state()
    folded = {entry["id"] for entry in state["items"]}
    index = plugin_index()
    modules = []
    for section in SECTIONS:
        for position, entry in enumerate(layout[section]):
            plugin_id = entry_id(entry)
            if plugin_id == "" or plugin_id == PLUGIN_ID or plugin_id in folded:
                continue
            meta = index.get(plugin_id, {})
            modules.append(
                {
                    "id": plugin_id,
                    "name": meta.get("name") or plugin_id,
                    "section": section,
                    "index": position,
                }
            )
    return out({"modules": modules})


def command_fold(args):
    plugin_id = required_id(args)
    if plugin_id == PLUGIN_ID:
        return die("OmaFolder cannot fold itself")
    state = load_state()
    if any(entry["id"] == plugin_id for entry in state["items"]):
        return out({"folded": False, "reason": "already folded", "count": len(state["items"])})

    shell = load_shell()
    layout = layout_of(shell)
    removed = remove_entry(layout, plugin_id)
    if removed is None:
        return die("%s is not on the bar" % plugin_id)

    state["items"].append(
        {
            "id": plugin_id,
            "active": True,
            "section": removed["section"],
            "index": removed["index"],
        }
    )
    save_state(state)
    backup(SHELL_PATH)
    atomic_write(SHELL_PATH, shell)
    reloaded = reload_shell()
    return out(
        {
            "folded": True,
            "id": plugin_id,
            "section": removed["section"],
            "index": removed["index"],
            "count": len(state["items"]),
            "reloaded": reloaded,
        }
    )


def command_eject(args):
    plugin_id = required_id(args)
    state = load_state()
    item = None
    remaining = []
    for entry in state["items"]:
        if entry["id"] == plugin_id and item is None:
            item = entry
        else:
            remaining.append(entry)
    if item is None:
        return die("%s is not folded" % plugin_id)

    shell = load_shell()
    layout = layout_of(shell)
    remove_entry(layout, plugin_id)
    section, position = insert_entry(layout, plugin_id, item.get("section"), item.get("index"))

    state["items"] = remaining
    save_state(state)
    backup(SHELL_PATH)
    atomic_write(SHELL_PATH, shell)
    reloaded = reload_shell()
    return out(
        {
            "ejected": True,
            "id": plugin_id,
            "section": section,
            "index": position,
            "count": len(state["items"]),
            "reloaded": reloaded,
        }
    )


def command_toggle(args):
    plugin_id = required_id(args)
    state = load_state()
    for entry in state["items"]:
        if entry["id"] == plugin_id:
            entry["active"] = not bool(entry.get("active", True))
            save_state(state)
            return out({"id": plugin_id, "active": entry["active"], "count": len(state["items"])})
    return die("%s is not folded" % plugin_id)


def command_active(args):
    plugin_id = required_id(args)
    if len(args) < 2:
        return die("usage: active <id> <true|false>")
    wanted = str(args[1]).strip().lower() in ("1", "true", "yes", "on")
    state = load_state()
    for entry in state["items"]:
        if entry["id"] == plugin_id:
            entry["active"] = wanted
            save_state(state)
            return out({"id": plugin_id, "active": wanted, "count": len(state["items"])})
    return die("%s is not folded" % plugin_id)


def command_reorder(args):
    plugin_id = required_id(args)
    if len(args) < 2:
        return die("usage: reorder <id> <index>")
    try:
        wanted = int(args[1])
    except (TypeError, ValueError):
        return die("index must be a number")
    state = load_state()
    items = state["items"]
    source = None
    for position, entry in enumerate(items):
        if entry["id"] == plugin_id:
            source = position
            break
    if source is None:
        return die("%s is not folded" % plugin_id)
    target = max(0, min(wanted, len(items) - 1))
    if target != source:
        items.insert(target, items.pop(source))
        save_state(state)
    return out({"id": plugin_id, "position": target, "count": len(items)})


def command_eject_all(_args):
    state = load_state()
    folded = [entry["id"] for entry in state["items"]]
    if not folded:
        return out({"ejected": 0, "count": 0})
    shell = load_shell()
    layout = layout_of(shell)
    restored = []
    for entry in state["items"]:
        remove_entry(layout, entry["id"])
        section, position = insert_entry(layout, entry["id"], entry.get("section"), entry.get("index"))
        restored.append({"id": entry["id"], "section": section, "index": position})
    state["items"] = []
    save_state(state)
    backup(SHELL_PATH)
    atomic_write(SHELL_PATH, shell)
    reloaded = reload_shell()
    return out({"ejected": len(restored), "restored": restored, "reloaded": reloaded})


def required_id(args):
    if not args or str(args[0]).strip() == "":
        raise SystemExit(die("usage: %s <plugin-id>" % (sys.argv[1] if len(sys.argv) > 1 else "")))
    return str(args[0]).strip()


COMMANDS = {
    "init": command_init,
    "summary": command_summary,
    "bar-modules": command_bar_modules,
    "fold": command_fold,
    "eject": command_eject,
    "eject-all": command_eject_all,
    "toggle": command_toggle,
    "active": command_active,
    "reorder": command_reorder,
}


def main(argv):
    if len(argv) < 2 or argv[1] in ("-h", "--help", "help"):
        return out({"commands": sorted(COMMANDS)})
    handler = COMMANDS.get(argv[1])
    if handler is None:
        return die("unknown command: %s" % argv[1])
    return handler(argv[2:])


if __name__ == "__main__":
    sys.exit(main(sys.argv))
